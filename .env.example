# Copy this file to .env (in the repo root) and adjust the values.

# PostgreSQL. This value matches docker-compose.yml.
DATABASE_URL=postgresql://nutriapp:nutriapp@localhost:5433/nutriapp

# API port. The front end (Vite) expects it at http://localhost:8080 by default.
PORT=8080

# AI (optional). Without a key the app works and the AI features are disabled.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1

# AI calls per user per day (photo analysis and summaries).
AI_DAILY_LIMIT=20

# If set, only people who know this code can sign up.
# SIGNUP_CODE=

# Only if the front end is served from a different domain than the API (comma-separated).
# CORS_ORIGIN=https://nutriapp.example.com
