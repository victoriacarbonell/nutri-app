# Copia este archivo a .env (en la raíz) y ajusta los valores.

# PostgreSQL. Este valor coincide con docker-compose.yml.
DATABASE_URL=postgresql://nutriapp:nutriapp@localhost:5432/nutriapp

# Puerto del API. El front (Vite) lo busca en http://localhost:8080 por defecto.
PORT=8080

# IA (opcional). Sin clave, la app funciona y las funciones de IA quedan desactivadas.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1
